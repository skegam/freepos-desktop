{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Permisos por defecto de la ventana principal de FreePOS",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:event:default",
    "store:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    }
  ]
}
