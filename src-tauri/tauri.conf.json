{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freepos-desktop",
  "version": "0.3.0",
  "identifier": "com.skegam.freepos-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "freepos-desktop",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5NjEzN0M5QTIxM0E2NjgKUldSb3BoT2l5VGRoU2NrU2Q2VExaZ0ZwV3RsNzhmcXZ1cEM0Z2xHWWI0WDVjMmQ0cmJYT0t4QysK",
      "endpoints": [
        "https://github.com/skegam/freepos-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
